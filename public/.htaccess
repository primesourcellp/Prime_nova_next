# Primenova — Apache static hosting (Next.js export)

Options -MultiViews
RewriteEngine On

# Prefer a real file/dir under api/ (e.g. plans/public/index.php) when present.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^api/v1/ - [L]
RewriteRule ^api/v1/(.*)$ subscription-proxy.php?__path=$1 [QSA,L]

# Browsers request /favicon.ico; we only ship SVG.
RewriteRule ^favicon\.ico$ favicon.svg [L]

# Next soft-nav RSC payloads are not present on static export hosts.
RewriteRule __next /index.html [L]

# Force HTTPS (uncomment if your host supports it)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# /products/ is a real directory (one folder per product code) and the
# listing page is products.html. Passing the directory through returns 403
# when it has no index.html.
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{DOCUMENT_ROOT}/%1/index.html !-f
RewriteCond %{DOCUMENT_ROOT}/%1/index.php !-f
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ /%1.html [L]

# Serve existing files, and directories that actually contain an index
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.html -f [OR]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.php -f
RewriteRule ^ - [L]

# Map clean URLs to .html files (e.g. /about -> /about.html)
RewriteCond %{REQUEST_URI} ^/(.+?)/?$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ /%1.html [L]

# Fallback to index.html for client routes
RewriteRule ^ index.html [L]

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache Next.js hashed assets aggressively
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
